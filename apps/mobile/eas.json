        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "developmentClient": false,
      "autoIncrement": true,
      "channel": "preview",
      "environment": "preview",
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "APP_VARIANT": "preview",
        "COACH_ENVIRONMENT": "staging",
        "EXPO_PUBLIC_API_URL": "https://communication-coach-staging-api-luckykiran2024s-projects.vercel.app/api",
        "EXPO_PUBLIC_PRIVACY_EMAIL": "support@c2coach.work",
        "EXPO_PUBLIC_PRIVACY_URL": "https://communication-coach-api.vercel.app/privacy",
        "EXPO_PUBLIC_SUPABASE_OAUTH_ENABLED": "true",
        "EXPO_PUBLIC_SUPABASE_URL": "https://szebsownsnvyrpwlbyau.supabase.co",
        "EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_DN2tL9QocNqdDwLjnapXNw_oEAebReW",
        "EXPO_PUBLIC_PAYMENT_PREVIEW": "true"
      }
    },
    "test-preview": {
      "extends": "preview",
      "channel": "test-preview",
      "env": {
        "EXPO_PUBLIC_SUPABASE_OAUTH_ENABLED": "true"
      }
    },
    "local-preview": {
      "extends": "preview",
      "channel": "local-preview",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_PRIVACY_EMAIL": "support@c2coach.work",
        "EXPO_PUBLIC_PRIVACY_URL": "https://communication-coach-api.vercel.app/privacy"
      }
    },
    "store-sandbox": {
      "extends": "production",
      "channel": "store-sandbox",
      "environment": "preview",
      "android": { "buildType": "app-bundle" },
      "env": {
        "APP_VARIANT": "production",
        "APP_NAME": "C2Coach",
        "APP_IDENTIFIER": "com.c2coach.app",
        "COACH_ENVIRONMENT": "staging",
        "EXPO_PUBLIC_PRIVACY_EMAIL": "support@c2coach.work",
