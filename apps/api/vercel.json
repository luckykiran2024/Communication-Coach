{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": false,
      "test-apk-ready": false
    }
  },
  "framework": null,
  "buildCommand": "npm run deploy:vercel",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/:__route*",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    },
    "api/[...path].js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/internal/cron/reap-voice-sessions",
      "schedule": "0 3 * * *"
    }
  ]
}
