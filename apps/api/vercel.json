{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": false,
      "codex/android-device-preview-20261106": false,
      "test-apk-ready": false
    }
  },
  "framework": null,
  "buildCommand": "npm run deploy:vercel",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/api/index"
    },
    {
      "source": "/account-deletion",
      "destination": "/api/index"
    },
    {
      "source": "/api/:__route*",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "prisma/supabase-ca.crt"
    },
    "api/[...path].js": {
      "maxDuration": 60,
      "includeFiles": "prisma/supabase-ca.crt"
    }
  },
  "crons": [
    {
      "path": "/api/internal/cron/reap-voice-sessions",
      "schedule": "* * * * *"
    }
  ]
}

