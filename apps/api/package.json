{
  "name": "@coach/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --require=../../scripts/node-os-compat.cjs ../../node_modules/tsx/dist/cli.mjs watch --env-file-if-exists=.env src/server.ts",
    "start": "node --require=../../scripts/node-os-compat.cjs ../../node_modules/tsx/dist/cli.mjs --env-file-if-exists=.env src/server.ts",
    "build:vercel": "esbuild src/vercel-handler.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js && node -e \"require('node:fs').copyFileSync('api/index.js', 'api/[...path].js')\"",
    "build:test-vercel": "esbuild src/test-vercel-handler.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js && node -e \"require('node:fs').copyFileSync('api/index.js', 'api/[...path].js')\"",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@coach/core": "*",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "6.19.2",
    "esbuild": "0.28.2",
    "fastify": "5.12.5",
    "google-auth-library": "11.1.0",
    "jose": "6.2.12",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "prisma": "6.19.2"
  }
}
