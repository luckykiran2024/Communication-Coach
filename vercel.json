{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "test-apk-ready": false
    }
  },
  "functions": {
    "apps/api/src/**/*.ts": {
      "includeFiles": "packages/core/**"
    },
    "apps/api/src/**/*.js": {
      "includeFiles": "packages/core/**"
    }
  }
}
